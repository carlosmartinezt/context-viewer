# systemd user unit: ~/.config/systemd/user/context-viewer.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now context-viewer
# No sudo: lingering is on for carlos, so it survives a reboot.

[Unit]
Description=context-viewer (behind Caddy)
After=network.target

[Service]
# The build, not the source tree. ops/build.sh stages ~/public/context-viewer.new
# and ops/release.sh swaps it here. Nothing in this directory is edited by hand
# and nothing in it needs the source tree to be present at run time.
WorkingDirectory=%h/public/context-viewer

# Secrets stay with the source: git-ignored, mode 600, and not something a
# release should be able to replace.
EnvironmentFile=%h/context-viewer/.env.local

# DATA_DIR lives in that .env.local rather than here, so the state paths are
# configuration rather than something baked into a unit file.

# Next's standalone output is a plain node server, so there is no `next start`
# and no node_modules/.bin to resolve. HOSTNAME is how that server picks its
# bind address; without it Next binds 0.0.0.0 and the app is reachable
# directly, bypassing Caddy. The CSRF check trusts X-Forwarded-Host precisely
# because only the proxy can reach us.
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3064
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2

# No mount-namespace sandboxing here, and that is deliberate rather than an
# oversight. ProtectSystem, ReadOnlyPaths and ReadWritePaths all need an
# unprivileged user namespace, which this box refuses
# (kernel.apparmor_restrict_unprivileged_userns=1 on Ubuntu 24.04), so systemd
# accepts the directives and silently confines nothing. Verified 8 Sep 2026 by
# writing outside ReadWritePaths from a unit that declared it.
#
# The real boundary is resolveWithin() in src/lib/safe.ts: no path reaches the
# filesystem without being proved inside ROOT_DIR first. If this ever needs
# kernel-level confinement too, it has to become a system unit, which costs the
# no-sudo property this one has.
NoNewPrivileges=true

[Install]
WantedBy=default.target
