# systemd user unit: ~/.config/systemd/user/context-viewer-demo.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now context-viewer-demo
# No sudo. Lingering must already be enabled for context-viewer to survive a
# reboot; this unit rides on the same enablement.
# %h is the home directory; the paths below assume the repo is
# ~/context-viewer-demo.

[Unit]
Description=context-viewer-demo (behind Caddy)
After=network.target

[Service]
WorkingDirectory=%h/context-viewer-demo
EnvironmentFile=%h/context-viewer-demo/.env.local
# Same port/host discipline as the production unit: -H is not optional, next
# start ignores HOST and binds 0.0.0.0 without it, bypassing Caddy.
ExecStart=%h/context-viewer-demo/node_modules/.bin/next start -H 127.0.0.1 -p 3065
Restart=on-failure
RestartSec=2

NoNewPrivileges=true

[Install]
WantedBy=default.target
