# Nothing here is required. Run `npm start` with none of this set and the
# app boots straight into /_ctx/setup: pick a directory, a username and a
# password, and you're in. The agent's API key and model are a settings-page
# field after that, not something to put here.
#
# Everything below is for a scripted or containered deployment that wants to
# seed all of this with no browser involved. Env always wins over whatever is
# saved through the UI, so setting any of these skips that part of setup.

# PORT=3064
# HOST=127.0.0.1

# The directory to serve, and where its state lives. DATA_DIR defaults to
# ./_data, next to the code, so most deployments never need either of these.
# ROOT_DIR=/srv/notes
# DATA_DIR=/var/lib/context-viewer

# npm run hash-password prints a PASSWORD_HASH. Colon-separated, not the usual
# $-separated PHC string: some env loaders read $16384 as a variable and
# silently truncate it. SESSION_SECRET can be anything long and random; leave
# it unset and one is generated and persisted for you on first boot.
# USERNAME=
# PASSWORD_HASH=
# SESSION_SECRET=
# SESSION_TTL_SECONDS=43200

# Set to false only when running over plain http on localhost: __Host- cookies
# require HTTPS, so this must stay true anywhere Caddy or another proxy
# terminates TLS in front of the app.
# SECURE_COOKIE=true

# Commit every write when ROOT_DIR is a git repo.
# GIT_COMMITS=true

# ANTHROPIC_API_KEY=
# MODEL=claude-opus-5
# AGENT_MAX_TURNS=12
